{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "emitDeclarationOnly": false,
        "incremental": false,
        "noEmit": true,
        "types": [
            "jest",
            "node"
        ]
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "dist/**/*",
        "node_modules"
    ],
    "references": [
        {
            "path": "../../core/ts"
        }
    ],
}