{
  "name": "semanticencoding",
  "version": "0.0.3",
  "type": "commonjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "An open semantic layer enabling LLM-native communication protocols.  The goal is to facilitate the creation, manipulation, and interpretation of SCE symbols and messages in order to provide a standardized approach for high-density low-token communication.  This is the primary package for end-users, and provides access to both the SCE SDK as well as a CLI and local MCP server.",
  "keywords": [
    "MCP",
    "LLM",
    "prompts",
    "semantic",
    "encoding",
    "SCE",
    "Semantic Encoding",
    "Semantic Communication Encoding"
  ],
  "author": {
    "name": "Sean O'Brien",
    "email": "seanmobrien@hotmail.com",
    "url": "https://github.com/seanmobrien/"
  },
  "bugs": {
    "url": "https://github.com/SemanticEncoding/sce/issues"
  },
  "homepage": "https://semanticencoding.github.io/sce/",
  "bin": {
    "sce": "./dist/cli.js",
    "semanticencoding": "./dist/sce-mcp-server.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "license": "EthicalUse-1.0",
  "files": [
    "dist/**/*",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../../scripts/copy-shared-to-packages.js && yarn exec tsc -p tsconfig.json",
    "build": "yarn exec tsc -p tsconfig.json",
    "build:publish": "yarn build && yarn pack --out ./dist/semanticencoding.tgz",
    "lint": "eslint --config ./eslint.config.cjs",
    "test": "yarn --cwd ../../../ exec jest --config ./packages/semanticencoding/ts/jest.config.cjs",
    "test:cover": "yarn --cwd ../../../ exec jest --coverage --config ./packages/semanticencoding/ts/jest.config.cjs"
  },
  "devDependencies": {
    "@types/node": "25.2.3",
    "typescript": "^5.9.3",
    "zod": "3.25.76"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.25.2",
    "@semanticencoding/core": "workspace:*"
  },
  "peerDependencies": {
    "zod": "3.25.76"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SemanticEncoding/sce.git"
  }
}
