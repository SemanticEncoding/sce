{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "rootDir": "./src",
        "declaration": true,
        "incremental": true,
        "tsBuildInfoFile": "./.tsbuildinfo",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": [
            "node"
        ],
        "typeRoots": [
            "./node_modules/@types"
        ]
    },
    "include": [
        "src/**/*",
    ],
    "exclude": [
        "**/coverage/**/*.*",
        "**/dist/**/*.*",
        "node_modules",
        "**/tests/**/*.*",
        "**/*.test.ts"
    ]
}